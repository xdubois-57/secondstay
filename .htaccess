# SecondStay — protection deny-by-default de la racine web.
# Ce fichier suppose que la totalite du depot peut se trouver sous le document root.
# Toute ressource non explicitement publique doit etre refusee.

Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Repertoires prives ---
    RewriteRule ^(?:public/)?(src|config|vendor|storage|tests|migrations|scripts|bootstrap|translations|templates|node_modules|coverage|build|dist|test-results|playwright-report|\.github|\.git|\.phpunit\.cache)(/|$) - [F,L,NC]

    # --- Fichiers caches (dotfiles), sauf .well-known ---
    RewriteRule (^|/)\.(?!well-known/)[^/]+ - [F,L]

    # --- Jeton de l'assistant d'installation ---
    # Ecrit par bootstrap.php a la racine, lu comme du texte par
    # l'application, jamais servi ni execute. La regle de rattrapage plus bas
    # l'enverrait de toute facon au controleur frontal ; celle-ci le refuse
    # explicitement, avant tout le reste.
    RewriteRule ^(?:public/)?token\.php$ - [F,L,NC]

    # --- Fichiers de developpement / documentation / metadonnees ---
    RewriteRule ^(?:public/)?(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml(\.dist)?|phpstan\.neon(\.dist)?|playwright\.config\.(js|ts)|vitest\.config\.(js|ts)|sonar-project\.properties|VERSION|LICENSE|MANIFEST\.md|.*\.md)$ - [F,L,NC]

    # --- Extensions jamais servies telles quelles ---
    RewriteRule \.(sql|sqlite|db|ini|log|bak|swp|dist|neon|yaml|yml|sh|env|pem|key|crt|p12|zip|tar|gz)$ - [F,L,NC]

    # --- Assets publics reels ---
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L]

    # --- Front controller ---
    RewriteCond %{REQUEST_URI} !^/public/index\.php$
    RewriteRule ^ public/index.php [L]
</IfModule>

<IfModule !mod_rewrite.c>
    # Sans mod_rewrite, on refuse tout par defaut plutot que d'exposer le depot.
    Require all denied
</IfModule>
