{% extends 'layout/base.html.twig' %}

{% block navigation %}
    <ul class="navbar-nav me-auto mb-2 mb-lg-0" data-testid="primary-menu">
        <li class="nav-item">
            <a class="nav-link" href="{{ path('home') }}">{{ t('nav.home') }}</a>
        </li>
    </ul>
{% endblock %}

{% block content %}
    <div class="container-fluid py-4">
        <div class="row g-4">
            <aside class="col-12 col-lg-3 col-xl-2">
                <nav aria-label="{{ t('admin.nav.administration') }}" data-testid="admin-nav">
                    {% for group in admin_menu|default([]) %}
                        {# Pas de titre de section : l'aside précède le h1 de la page, et l'ordre des titres doit rester juste. #}
                        <p class="text-uppercase text-body-secondary small fw-semibold mt-3 mb-1 px-3" id="admin-nav-{{ group.id }}">{{ t(group.label) }}</p>
                        <ul class="nav flex-column nav-pills" aria-labelledby="admin-nav-{{ group.id }}" data-admin-group="{{ group.id }}">
                            {% for section in group.items %}
                                <li class="nav-item">
                                    <a class="nav-link py-1{{ admin_section == section.id ? ' active' : '' }}{{ section.disabled ? ' text-body-secondary' : '' }}"
                                       href="{{ path(section.route) }}"
                                       data-admin-section="{{ section.id }}"
                                       {{ section.disabled ? 'data-disabled="true"' : '' }}
                                       {{ admin_section == section.id ? 'aria-current="page"' : '' }}>
                                        {{ t(section.label) }}
                                        {% if section.disabled %}<span class="badge text-bg-light border ms-1">{{ t('admin.nav.disabled') }}</span>{% endif %}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endfor %}
                </nav>
            </aside>
            <div class="col-12 col-lg-9 col-xl-10">
                <h1 class="h3 mb-4">{% block admin_title %}{{ meta_title }}{% endblock %}</h1>
                {% block admin_content %}{% endblock %}
            </div>
        </div>
    </div>
{% endblock %}
