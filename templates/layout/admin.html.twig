{% extends 'layout/base.html.twig' %}

{#
  Pages d'administration — même dessin que les pages Finances de ScoutMagic :
  le menu « Administration » de la barre mène à la page ; en tête de page, un
  titre unique (`partials/page_header.html.twig`), puis une barre d'onglets
  soulignés vers les autres pages du même groupe (`partials/nav_rail.html.twig`).
  La colonne latérale qui répétait tout le menu a disparu : le menu et le fil
  d'Ariane disent déjà où l'on est.

  Le groupe affiché est celui qui contient la page courante, d'après les menus
  construits par `SiteNavigation`. Une page de détail (une réservation) garde
  sa liste sélectionnée.
#}
{% block content %}
    {% set _admin_group = null %}
    {% for menu in menus|default([]) %}
        {% if menu.id == 'admin' %}
            {% for group in menu.groups %}
                {% for page in group.pages %}
                    {% if _admin_group is null and page.id == admin_section|default('') %}
                        {% set _admin_group = group %}
                    {% endif %}
                {% endfor %}
            {% endfor %}
        {% endif %}
    {% endfor %}
    <div class="container py-3">
        {% include 'partials/page_header.html.twig' with {
            title_html: block('admin_title'),
        } only %}

        {% if _admin_group is not null and _admin_group.pages|length > 1 %}
            {% set _rail = [] %}
            {% for page in _admin_group.pages %}
                {% set _rail = _rail|merge([{
                    url: path(page.route, page.params),
                    label: t(page.label_key),
                    icon: page.icon,
                    selected: page.id == admin_section|default(''),
                    attributes: {'data-admin-rail': page.id},
                }]) %}
            {% endfor %}
            {% include 'partials/nav_rail.html.twig' with {
                rail_id: 'admin-page-picker',
                items: _rail,
                aria_label: t(_admin_group.label_key),
                testid: 'admin-nav',
            } only %}
        {% endif %}

        {% block admin_content %}{% endblock %}
    </div>
{% endblock %}

{% block admin_title %}{{ meta_title }}{% endblock %}
