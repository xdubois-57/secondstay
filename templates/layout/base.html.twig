<!doctype html>
<html lang="{{ locale }}" data-base-path="{{ base_path }}" data-bs-theme="light" data-theme-mode="auto">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ meta_title|default(t('common.app_name')) }}{% endblock %} — {{ app_name }}</title>
    <meta name="description" content="{{ meta_description|default(t('common.tagline')) }}">
    <meta name="generator" content="SecondStay">
    {% if meta_robots is defined and meta_robots %}
        {# Pages propres à un séjour : jamais indexées. #}
        <meta name="robots" content="{{ meta_robots }}">
    {% endif %}
    <meta property="og:site_name" content="{{ app_name }}">
    <meta property="og:title" content="{{ meta_title|default(t('common.app_name')) }}">
    <meta property="og:description" content="{{ meta_description|default(t('common.tagline')) }}">
    <meta property="og:locale" content="{{ locale }}">
    <meta property="og:type" content="website">
    {% for alternate in locales %}
        <link rel="alternate" hreflang="{{ alternate }}" href="{{ base_path }}/{{ alternate }}{{ current_path == '/' ? '/' : current_path }}">
    {% endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ base_path }}/{{ 'fr' }}{{ current_path == '/' ? '/' : current_path }}">
    <link rel="canonical" href="{{ base_path }}/{{ locale }}{{ current_path == '/' ? '/' : current_path }}">
    <link rel="stylesheet" href="{{ base_path }}/assets/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="{{ base_path }}/assets/vendor/bootstrap-icons/bootstrap-icons.min.css">
    <link rel="stylesheet" href="{{ base_path }}/assets/css/app.css">
    <link rel="manifest" href="{{ base_path }}/manifest.webmanifest?locale={{ locale }}">
    <link rel="icon" href="{{ base_path }}/icon-192.png" sizes="192x192" type="image/png">
    <link rel="apple-touch-icon" href="{{ base_path }}/icon-192.png">
    <meta name="theme-color" content="#0d6efd">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="{{ app_name }}">
    {% if structured_data is defined and structured_data %}
        <script type="application/ld+json">{{ structured_data|raw }}</script>
    {% endif %}
    {% block head %}{% endblock %}
</head>
<body class="d-flex flex-column min-vh-100" data-toast-close-label="{{ t('common.close') }}">
<a class="visually-hidden-focusable skip-link" href="#main-content">{{ t('common.skip_to_content') }}</a>

{% block navigation %}
    {% include 'partials/nav.html.twig' %}
{% endblock %}
{% block breadcrumb %}
    {% include 'partials/breadcrumb_bar.html.twig' %}
{% endblock %}

<main id="main-content" class="flex-grow-1">
    {% if flashes is defined and flashes %}
        <div class="container mt-3" data-testid="flash-messages">
            {% for flash in flashes %}
                <div class="alert alert-{{ flash.type }} alert-dismissible fade show" role="alert" data-flash-type="{{ flash.type }}">
                    {{ t(flash.key) }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ t('common.close') }}"></button>
                </div>
            {% endfor %}
        </div>
    {% endif %}
    {% block content %}{% endblock %}
</main>

<footer class="border-top py-3 mt-4">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2 small text-body-secondary">
        <span>{{ app_name }} — {{ t('common.tagline') }}</span>
        <div class="d-flex flex-wrap align-items-center gap-3">
            {% if legal_links|default([]) is not empty %}
                <nav aria-label="{{ t('content.legal_footer') }}" data-testid="legal-links">
                    <ul class="list-inline mb-0 d-flex flex-wrap gap-3">
                        {% for link in legal_links %}
                            <li class="list-inline-item m-0">
                                <a class="ss-link-muted text-decoration-none" href="{{ path('page.show', {'slug': link.slug}) }}"
                                   data-legal-slug="{{ link.slug }}">{{ link.label }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                </nav>
            {% endif %}
            <span data-app-version>{{ t('common.version') }} {{ app_version }}</span>
        </div>
    </div>
</footer>

<script src="{{ base_path }}/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script type="module" src="{{ base_path }}/assets/js/app.js"></script>
{% block scripts %}{% endblock %}
</body>
</html>
