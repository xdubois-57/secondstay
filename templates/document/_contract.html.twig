{# Lecture et acceptation du contrat, côté voyageur. #}
<div class="card mb-4" data-testid="contract-panel"
     data-accepted="{{ contract_acceptance ? 'true' : 'false' }}">
    <div class="card-header">{{ t('contract.accept.title') }}</div>
    <div class="card-body">
        <p>
            <a class="btn btn-outline-secondary" target="_blank" rel="noopener"
               href="{{ path('contract.show', {'reference': booking.reference}) }}"
               data-testid="contract-read">{{ t('contract.accept.read') }}</a>
        </p>

        {% if contract_acceptance %}
            <p class="mb-1">
                <span class="badge text-bg-success" data-testid="contract-accepted">{{ t('contract.accept.accepted') }}</span>
            </p>
            <p class="small text-body-secondary mb-0">
                {{ t('contract.accept.accepted_on', {'date': contract_acceptance.acceptedAt}) }}
                — {{ t('contract.accept.accepted_version', {
                    'version': contract_acceptance.version,
                    'locale': contract_acceptance.locale|upper
                }) }}
                — {{ t('document.fingerprint') }} <code>{{ contract_acceptance.shortHash }}</code>
            </p>
        {% else %}
            <p class="text-body-secondary">{{ t('contract.accept.pending') }}</p>
            <form method="post" action="{{ path('contract.accept', {'reference': booking.reference}) }}">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="accept" id="accept_contract" value="1">
                    <label class="form-check-label" for="accept_contract">{{ t('contract.accept.confirm') }}</label>
                </div>
                <button class="btn btn-primary" type="submit"
                        data-testid="contract-accept">{{ t('contract.accept.action') }}</button>
            </form>
        {% endif %}
    </div>
</div>
