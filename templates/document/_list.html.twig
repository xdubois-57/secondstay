{# Documents d'un séjour, partagés entre l'espace client et l'administration. #}
<div class="card mb-4" data-testid="document-list">
    <div class="card-header">{{ t('document.title') }}</div>
    {% if documents is empty %}
        <div class="card-body text-body-secondary" data-testid="documents-empty">{{ t('document.empty') }}</div>
    {% else %}
        <ul class="list-group list-group-flush">
            {% for document in documents %}
                <li class="list-group-item d-flex justify-content-between align-items-start gap-3"
                    data-document="{{ document.id }}"
                    data-kind="{{ document.kind.value }}"
                    data-source="{{ document.source.value }}">
                    <div class="min-width-0">
                        <a href="{{ path('document.download', {'id': document.id}) }}"
                           data-testid="document-link-{{ document.kind.value }}">{{ document.filename }}</a>
                        <span class="d-block small text-body-secondary">
                            {{ t(document.kind.labelKey) }} — {{ t(document.source.labelKey) }}
                            {% if document.sender %} — {{ document.sender }}{% endif %}
                        </span>
                    </div>
                    <span class="text-nowrap small text-body-secondary">{{ document.humanSize }}</span>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
