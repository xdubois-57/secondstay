{% extends 'layout/base.html.twig' %}

{% block content %}
    <section class="py-5 bg-body-secondary border-bottom" data-testid="hero" data-season="{{ season }}">
        <div class="container">
            <h1 class="display-5 fw-semibold">{{ translation ? translation.title : t('home.hero_title') }}</h1>
            {% if translation and translation.lead %}
                <p class="lead mb-4" data-testid="home-lead">{{ translation.lead }}</p>
            {% endif %}
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary btn-lg" href="{{ path('page.show', {'slug': 'availability'}) }}">{{ t('home.cta_availability') }}</a>
                <a class="btn btn-outline-secondary btn-lg" href="{{ path('page.show', {'slug': 'contact'}) }}">{{ t('home.cta_contact') }}</a>
            </div>
        </div>
    </section>

    {% if is_fallback_translation %}
        <div class="container mt-3">
            <p class="alert alert-warning mb-0" data-testid="fallback-notice">{{ t('content.fallback_notice') }}</p>
        </div>
    {% endif %}

    <section class="py-5">
        <div class="container">
            <div class="ss-rich-text" data-testid="home-body">{{ translation ? translation.body|raw : '' }}</div>
        </div>
    </section>

    {% if gallery_preview is defined and gallery_preview is not empty %}
        <section class="pb-5">
            <div class="container">
                <h2 class="h4 mb-3">{{ t('nav.gallery') }}</h2>
                <div class="ss-gallery-grid" data-testid="home-gallery">
                    {% for item in gallery_preview %}
                        <a href="{{ path('page.show', {'slug': 'gallery'}) }}" class="d-block">
                            <img class="img-fluid rounded" loading="lazy"
                                 src="{{ base_path }}/media/thumb/{{ item.filename }}"
                                 alt="{{ item.alt }}" width="{{ item.width }}" height="{{ item.height }}">
                        </a>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}
{% endblock %}
