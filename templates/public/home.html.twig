{% extends 'layout/base.html.twig' %}

{% block content %}
    <section class="py-5 bg-body-secondary border-bottom" data-testid="hero">
        <div class="container">
            <h1 class="display-5 fw-semibold">{{ t('home.hero_title') }}</h1>
            <p class="lead mb-4">{{ t('home.hero_subtitle') }}</p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary btn-lg" href="{{ path('home') }}">{{ t('home.cta_availability') }}</a>
                <a class="btn btn-outline-secondary btn-lg" href="{{ path('home') }}">{{ t('home.cta_contact') }}</a>
            </div>
        </div>
    </section>

    <section class="py-5">
        <div class="container">
            <p class="mb-0" data-testid="home-intro">{{ t('home.intro') }}</p>
        </div>
    </section>
{% endblock %}
