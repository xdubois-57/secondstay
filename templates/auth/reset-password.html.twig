{% extends 'layout/base.html.twig' %}

{% block content %}
    <section class="py-5">
        <div class="container" style="max-width: 34rem;">
            <h1 class="h3 mb-3">{{ t('account.reset.title') }}</h1>

            {% if error_key %}
                <div class="alert alert-danger" role="alert" data-testid="reset-error">{{ t(error_key) }}</div>
            {% endif %}

            <form method="post" action="{{ path('account.reset.submit') }}" novalidate data-testid="reset-form">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <input type="hidden" name="token" value="{{ token }}">

                <div class="mb-3">
                    <label class="form-label" for="password">{{ t('account.reset.new_password') }}</label>
                    <input class="form-control" id="password" name="password" type="password"
                           autocomplete="new-password" minlength="{{ min_password_length }}" required data-password-input>
                    <div class="form-text">{{ t('auth.password.requirements', {'length': min_password_length}) }}</div>
                    <progress class="ss-strength mt-2" max="100" value="0" data-password-strength
                                  aria-label="{{ t('auth.password.strength') }}"></progress>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="password_confirm">{{ t('auth.field.password_confirm') }}</label>
                    <input class="form-control" id="password_confirm" name="password_confirm" type="password"
                           autocomplete="new-password" required>
                </div>

                <button class="btn btn-primary w-100" type="submit">{{ t('account.reset.action') }}</button>
            </form>
        </div>
    </section>
{% endblock %}
