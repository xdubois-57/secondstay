{% extends 'layout/base.html.twig' %}

{% block content %}
    <section class="py-5">
        <div class="container" style="max-width: 32rem;">
            <h1 class="h3 mb-4">{{ t('auth.login.title') }}</h1>

            {% if error_key %}
                <div class="alert alert-danger" role="alert" data-testid="login-error">{{ t(error_key) }}</div>
            {% endif %}

            <form method="post" action="{{ path('login.submit') }}" novalidate data-testid="login-form">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">

                <div class="mb-3">
                    <label class="form-label" for="email">{{ t('auth.field.email') }}</label>
                    <input class="form-control" type="email" id="email" name="email" value="{{ email }}"
                           autocomplete="username" inputmode="email" required autofocus>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="password">{{ t('auth.field.password') }}</label>
                    <input class="form-control" type="password" id="password" name="password"
                           autocomplete="current-password" required>
                </div>

                <button class="btn btn-primary w-100" type="submit">{{ t('auth.login.action') }}</button>
            </form>

            {% if passkeys_enabled %}
                <div class="text-center my-3 text-body-secondary small">{{ t('auth.login.or') }}</div>
                <button class="btn btn-outline-primary w-100" type="button" hidden
                        data-passkey-signin data-csrf="{{ csrf_token }}" data-base="{{ base_path }}"
                        data-testid="passkey-signin">{{ t('account.passkey.sign_in') }}</button>
                <output class="small mt-2 mb-0 text-center d-block" data-passkey-signin-status></output>
            {% endif %}

            <div class="d-flex justify-content-between mt-4 small">
                <a href="{{ path('account.forgot') }}" data-testid="forgot-link">{{ t('account.forgot.title') }}</a>
                {% if signup_enabled %}
                    <a href="{{ path('account.signup') }}" data-testid="signup-link">{{ t('account.signup.action') }}</a>
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}
