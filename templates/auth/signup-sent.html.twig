{% extends 'layout/base.html.twig' %}

{% block content %}
    <section class="py-5">
        <div class="container" style="max-width: 36rem;" data-testid="signup-sent">
            <h1 class="h3 mb-3">{{ t('account.signup.sent_title') }}</h1>
            <p>{{ t('account.signup.sent_message', {'email': email}) }}</p>
            <p class="text-body-secondary">{{ t('account.signup.sent_hint') }}</p>
            <a class="btn btn-outline-secondary" href="{{ path('home') }}">{{ t('error.back_home') }}</a>
        </div>
    </section>
{% endblock %}
