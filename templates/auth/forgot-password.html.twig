{% extends 'layout/base.html.twig' %}

{% block content %}
    <section class="py-5">
        <div class="container" style="max-width: 34rem;">
            <h1 class="h3 mb-3">{{ t('account.forgot.title') }}</h1>

            {% if sent %}
                <p class="alert alert-success" data-testid="forgot-sent">{{ t('account.forgot.sent') }}</p>
                <a class="btn btn-outline-secondary" href="{{ path('login') }}">{{ t('auth.login.action') }}</a>
            {% else %}
                <p class="text-body-secondary">{{ t('account.forgot.intro') }}</p>
                <form method="post" action="{{ path('account.forgot.submit') }}" data-testid="forgot-form">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <div class="mb-3">
                        <label class="form-label" for="email">{{ t('auth.field.email') }}</label>
                        <input class="form-control" id="email" name="email" type="email" value="{{ email }}"
                               autocomplete="email" inputmode="email" required autofocus>
                    </div>
                    <button class="btn btn-primary w-100" type="submit">{{ t('account.forgot.action') }}</button>
                </form>
            {% endif %}
        </div>
    </section>
{% endblock %}
