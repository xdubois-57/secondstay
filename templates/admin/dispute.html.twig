{% extends 'layout/admin.html.twig' %}

{% block admin_content %}
    <p><a href="{{ path('admin.disputes') }}">← {{ t('dispute.title') }}</a></p>

    <div class="card mb-4" data-testid="dispute-detail" data-dispute-id="{{ dispute.id }}"
         data-dispute-status="{{ dispute.status.value }}">
        <div class="card-header d-flex justify-content-between align-items-center gap-2">
            <span>{{ dispute.summary }}</span>
            <span class="badge {{ dispute.status.badgeClass }}"
                  data-testid="dispute-status">{{ t(dispute.status.labelKey) }}</span>
        </div>
        <ul class="list-group list-group-flush">
            <li class="list-group-item d-flex justify-content-between gap-2">
                <span>{{ t('dispute.field.booking') }}</span>
                <strong><a href="{{ path('admin.bookings.show', {'id': booking.id}) }}">{{ booking.reference }}</a></strong>
            </li>
            <li class="list-group-item d-flex justify-content-between gap-2">
                <span>{{ t('dispute.field.claimed') }}</span>
                <strong data-dispute-claimed>{{ dispute.claimedCents|money }}</strong>
            </li>
            {% if dispute.status.isResolved %}
                <li class="list-group-item d-flex justify-content-between gap-2">
                    <span>{{ t('dispute.field.settled') }}</span>
                    <strong data-dispute-settled>{{ dispute.settledCents|money }}</strong>
                </li>
                <li class="list-group-item d-flex justify-content-between gap-2">
                    <span>{{ t('dispute.field.waived') }}</span>
                    <strong>{{ dispute.waivedCents|money }}</strong>
                </li>
                {% if dispute.resolution %}
                    <li class="list-group-item" style="white-space: pre-line;">{{ dispute.resolution }}</li>
                {% endif %}
            {% endif %}
        </ul>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-6">
            {# Ce que le produit a déjà collecté : la discussion s'appuie
               dessus plutôt que sur des souvenirs. #}
            <div class="card mb-4">
                <div class="card-header">{{ t('dispute.evidence') }}</div>
                <ul class="list-group list-group-flush" data-testid="dispute-evidence">
                    <li class="list-group-item d-flex justify-content-between gap-2" data-evidence="deposit">
                        <span>{{ t('dispute.evidence_field.deposit') }}</span>
                        <strong>{{ evidence.deposit_held_cents|money }}</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between gap-2" data-evidence="checkout">
                        <span>{{ t('dispute.evidence_field.checkout') }}</span>
                        <strong>{{ evidence.checkout_completed ? t('common.yes') : t('common.no') }}</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between gap-2" data-evidence="anomalies">
                        <span>{{ t('dispute.evidence_field.anomalies') }}</span>
                        <strong>{{ evidence.checkout_anomalies }}</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between gap-2" data-evidence="photos">
                        <span>{{ t('dispute.evidence_field.photos') }}</span>
                        <strong>{{ evidence.photos }}</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between gap-2" data-evidence="incidents">
                        <span>{{ t('dispute.evidence_field.incidents') }}</span>
                        <strong>{{ evidence.incidents }}</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between gap-2" data-evidence="contract">
                        <span>{{ t('dispute.evidence_field.contract') }}</span>
                        <strong>{{ evidence.contract_accepted ? t('common.yes') : t('common.no') }}</strong>
                    </li>
                </ul>
            </div>

            <div class="card">
                <div class="card-header">{{ t('dispute.actions') }}</div>
                <div class="card-body">
                    {% for target in transitions %}
                        <form method="post" class="mb-3"
                              action="{{ path('admin.disputes.status', {'id': dispute.id}) }}">
                            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                            <input type="hidden" name="status" value="{{ target.value }}">
                            {% if target.value == 'resolved' %}
                                <label class="form-label" for="settled">{{ t('dispute.field.settled') }}</label>
                                <input class="form-control mb-2" type="number" step="0.01" min="0"
                                       id="settled" name="settled" value="0">
                                <label class="form-label" for="resolution">{{ t('dispute.field.resolution') }}</label>
                                <textarea class="form-control mb-2" rows="2" id="resolution" name="resolution"></textarea>
                            {% endif %}
                            <button class="btn btn-outline-primary" type="submit"
                                    data-testid="dispute-to-{{ target.value }}">{{ t('dispute.action.' ~ target.value) }}</button>
                        </form>
                    {% else %}
                        <p class="text-body-secondary mb-0">{{ t('dispute.no_transition') }}</p>
                    {% endfor %}

                    <form method="post" action="{{ path('admin.disputes.comment', {'id': dispute.id}) }}">
                        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                        <label class="form-label" for="note">{{ t('dispute.field.note') }}</label>
                        <div class="input-group">
                            <input class="form-control" id="note" name="note" maxlength="255">
                            <button class="btn btn-outline-secondary" type="submit"
                                    data-testid="dispute-comment">{{ t('common.send') }}</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card">
                <div class="card-header">{{ t('dispute.history') }}</div>
                <ul class="list-group list-group-flush" data-testid="dispute-history">
                    {% for event in dispute.events %}
                        <li class="list-group-item" data-dispute-event="{{ event.type }}">
                            <div class="d-flex justify-content-between gap-2">
                                <strong>{{ t(event.labelKey) }}</strong>
                                <span class="small text-body-secondary">{{ event.createdDate|localdatetime('short') }}</span>
                            </div>
                            {% if event.note %}<div class="small">{{ event.note }}</div>{% endif %}
                            {% if event.actorLabel %}
                                <div class="small text-body-secondary">{{ event.actorLabel }}</div>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
{% endblock %}
