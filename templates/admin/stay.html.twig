{% extends 'layout/admin.html.twig' %}

{% block admin_content %}
    <p class="text-body-secondary">{{ t('stay.admin.intro') }}</p>

    <ul class="nav nav-tabs mb-4" data-testid="stay-locales">
        {% for available in locales %}
            <li class="nav-item">
                <a class="nav-link{{ available == current_locale ? ' active' : '' }}"
                   href="{{ path('admin.stay') }}?locale={{ available }}"
                   data-stay-locale="{{ available }}">{{ locale_name(available) }}</a>
            </li>
        {% endfor %}
    </ul>

    <div class="card mb-4">
        <div class="card-header">{{ t('stay.admin.completeness') }}</div>
        <ul class="list-group list-group-flush" data-testid="stay-completeness">
            {% for code, filled in completeness %}
                <li class="list-group-item d-flex justify-content-between align-items-center"
                    data-block="{{ code }}">
                    <span>{{ t('stay.block.' ~ code) }}</span>
                    <span>
                        {% for available in locales %}
                            <span class="badge {{ available in filled ? 'text-bg-success' : 'text-bg-secondary' }}"
                                  data-locale="{{ available }}"
                                  data-filled="{{ available in filled ? 'true' : 'false' }}">{{ available|upper }}</span>
                        {% endfor %}
                    </span>
                </li>
            {% endfor %}
        </ul>
    </div>

    {% if errors is defined and errors %}
        {# Rendu ici et non par un message éphémère : un flash écrit pendant
           cette requête ne serait lu qu'à la page suivante, loin de la saisie
           qu'il concerne. #}
        <div class="alert alert-danger" role="alert" data-testid="stay-errors">
            {{ t('stay.admin.not_saved') }}
        </div>
    {% endif %}

    {#
        `novalidate` comme sur les autres formulaires saisis du produit : la
        validation est faite côté serveur et rendue par des clés de traduction
        (`invalid-feedback`), là où les bulles natives parlent la langue du
        navigateur et non celle de la page (I18N.md, AGENTS.md §6).

        Sans lui, WebKit refuse en silence de soumettre après le vidage d'un
        champ `type="date"` qui portait une valeur : `checkValidity()` du
        formulaire rend `false` alors qu'aucun indicateur de `validity` n'est
        levé sur le champ. L'utilisateur d'iPhone efface la date « Vérifiée
        le », appuie sur Enregistrer, et rien ne se passe.
    #}
    <form method="post" action="{{ path('admin.stay.save') }}" novalidate data-testid="stay-form">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        <input type="hidden" name="locale" value="{{ current_locale }}">

        {% for field in fields %}
            <div class="card mb-3" data-block-editor="{{ field.code }}">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>{{ t('stay.block.' ~ field.code) }}</span>
                    <span class="badge text-bg-secondary">{{ t('stay.phase.' ~ (field.phase == 'any' ? 'during' : field.phase)) }}</span>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="title_{{ field.code }}">{{ t('stay.admin.block_title') }}</label>
                        <input class="form-control" id="title_{{ field.code }}" name="title_{{ field.code }}"
                               maxlength="190" value="{{ field.title }}">
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="body_{{ field.code }}">{{ t('stay.admin.block_body') }}</label>
                        <textarea class="form-control" id="body_{{ field.code }}" name="body_{{ field.code }}"
                                  rows="4">{{ field.body }}</textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="media_{{ field.code }}">{{ t('stay.admin.illustration') }}</label>
                        <select class="form-select" id="media_{{ field.code }}" name="media_{{ field.code }}">
                            <option value="0">{{ t('stay.admin.no_illustration') }}</option>
                            {% for item in media %}
                                <option value="{{ item.id }}"
                                        {{ field.media_id == item.id ? 'selected' : '' }}>{{ item.label }}</option>
                            {% endfor %}
                        </select>
                        <p class="form-text mb-0">{{ t('stay.admin.illustration_help') }}</p>
                    </div>

                    {# Carte et source (SPECIFICATIONS.md §55). Les deux
                       adresses ne sont jamais récupérées par le serveur :
                       elles ne deviennent qu'un lien dans le livret. #}
                    <div class="row g-2 mb-3">
                        <div class="col-12 col-md-7">
                            <label class="form-label" for="link_url_{{ field.code }}">{{ t('stay.admin.link_url') }}</label>
                            <input class="form-control{{ field.link_error ? ' is-invalid' : '' }}"
                                   type="url" inputmode="url"
                                   id="link_url_{{ field.code }}" name="link_url_{{ field.code }}"
                                   maxlength="500" value="{{ field.link_url }}"
                                   placeholder="https://">
                            {% if field.link_error %}
                                <div class="invalid-feedback">{{ t(field.link_error) }}</div>
                            {% endif %}
                        </div>
                        <div class="col-12 col-md-5">
                            <label class="form-label" for="link_label_{{ field.code }}">{{ t('stay.admin.link_label') }}</label>
                            <input class="form-control" id="link_label_{{ field.code }}"
                                   name="link_label_{{ field.code }}" maxlength="120"
                                   value="{{ field.link_label }}">
                        </div>
                        <div class="col-12">
                            <p class="form-text mb-0">{{ t('stay.admin.link_help') }}</p>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-12 col-md-7">
                            <label class="form-label" for="source_url_{{ field.code }}">{{ t('stay.admin.source_url') }}</label>
                            <input class="form-control{{ field.source_error ? ' is-invalid' : '' }}"
                                   type="url" inputmode="url"
                                   id="source_url_{{ field.code }}" name="source_url_{{ field.code }}"
                                   maxlength="500" value="{{ field.source_url }}"
                                   placeholder="https://">
                            {% if field.source_error %}
                                <div class="invalid-feedback">{{ t(field.source_error) }}</div>
                            {% endif %}
                        </div>
                        <div class="col-12 col-md-5">
                            <label class="form-label" for="source_checked_on_{{ field.code }}">{{ t('stay.admin.source_checked_on') }}</label>
                            <input class="form-control{{ field.date_error ? ' is-invalid' : '' }}"
                                   type="date"
                                   id="source_checked_on_{{ field.code }}"
                                   name="source_checked_on_{{ field.code }}"
                                   value="{{ field.source_checked_on }}">
                            {% if field.date_error %}
                                <div class="invalid-feedback">{{ t(field.date_error) }}</div>
                            {% endif %}
                        </div>
                        <div class="col-12">
                            <p class="form-text mb-0">{{ t('stay.admin.source_help') }}</p>
                        </div>
                    </div>

                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox"
                               id="published_{{ field.code }}" name="published_{{ field.code }}" value="1"
                               {{ field.published ? 'checked' : '' }}>
                        <label class="form-check-label" for="published_{{ field.code }}">{{ t('stay.admin.published') }}</label>
                    </div>

                    {# QR physiques (SPECIFICATIONS.md §47) : refusé par
                       défaut, décidé bloc par bloc. Le livret contient des
                       choses qui n'ont rien à faire sur le web ouvert. #}
                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox"
                               id="public_{{ field.code }}" name="public_{{ field.code }}" value="1"
                               {{ field.public ? 'checked' : '' }}>
                        <label class="form-check-label" for="public_{{ field.code }}">{{ t('stay.admin.public') }}</label>
                        <p class="form-text mb-0">{{ t('stay.admin.public_help') }}</p>
                    </div>

                    {% if field.public %}
                        <div class="d-flex align-items-center gap-3 mt-3 flex-wrap"
                             data-testid="qr-{{ field.code }}">
                            <div style="width: 7rem;">{{ field.qr|raw }}</div>
                            <div>
                                <p class="mb-1 small text-body-secondary">{{ t('stay.admin.public_url') }}</p>
                                <code class="text-break" data-testid="qr-url-{{ field.code }}">{{ field.url }}</code>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}

        <button class="btn btn-primary" type="submit" data-testid="stay-save">{{ t('stay.admin.save') }}</button>
    </form>

    <div class="card mt-4">
        <div class="card-header">{{ t('stay.admin.secrets') }}</div>
        <div class="card-body">
            <p class="text-body-secondary">{{ t('stay.admin.secrets_intro') }}</p>
            <form method="post" action="{{ path('admin.stay.secrets') }}" data-testid="stay-secrets-form">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                {% for secret in secrets %}
                    <div class="row g-2 align-items-end mb-3" data-secret="{{ secret.code }}">
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="secret_{{ secret.code }}">{{ t('stay.secret.' ~ secret.code) }}</label>
                            <input class="form-control" type="password" autocomplete="new-password"
                                   id="secret_{{ secret.code }}" name="secret_{{ secret.code }}"
                                   placeholder="{{ secret.defined ? secret.preview : t('stay.admin.not_set') }}">
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       id="clear_{{ secret.code }}" name="clear_{{ secret.code }}" value="1">
                                <label class="form-check-label" for="clear_{{ secret.code }}">{{ t('stay.admin.clear') }}</label>
                            </div>
                        </div>
                    </div>
                {% endfor %}
                <button class="btn btn-primary" type="submit"
                        data-testid="stay-secrets-save">{{ t('stay.admin.save') }}</button>
            </form>
        </div>
    </div>
{% endblock %}
