{% extends 'layout/admin.html.twig' %}

{% block admin_content %}
    <p class="text-body-secondary">{{ t('compliance.intro') }}</p>
    <p class="alert alert-secondary" data-testid="compliance-disclaimer">{{ t('compliance.disclaimer') }}</p>

    <div class="row g-3 mb-4" data-testid="compliance-summary">
        {% for key in ['compliant', 'to_verify', 'not_applicable', 'overdue'] %}
            <div class="col-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="h4 mb-0" data-summary="{{ key }}">{{ summary[key] }}</div>
                        <div class="small text-body-secondary">
                            {{ key == 'overdue' ? t('compliance.overdue') : t('compliance.status.' ~ key) }}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    {# --- Textes légaux versionnés ------------------------------------- #}
    <div class="card mb-4">
        <div class="card-header">{{ t('legal.title') }}</div>
        <div class="card-body">
            <p class="small text-body-secondary mb-3">{{ t('legal.intro') }}</p>

            {% for entry in legal %}
                <div class="mb-4" data-legal-type="{{ entry.type.value }}">
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                        <strong>{{ t(entry.type.labelKey) }}</strong>
                        <span>
                            {% for locale in locales %}
                                <span class="badge {{ entry.current[locale] ? 'text-bg-success' : 'text-bg-secondary' }}"
                                      data-locale="{{ locale }}"
                                      data-version="{{ entry.current[locale] }}">{{ locale|upper }}{{ entry.current[locale] ? ' ' ~ entry.current[locale] : '' }}</span>
                            {% endfor %}
                        </span>
                    </div>

                    <form method="post" action="{{ path('admin.legal.publish') }}"
                          data-testid="legal-publish-{{ entry.type.value }}">
                        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                        <input type="hidden" name="type" value="{{ entry.type.value }}">
                        <div class="input-group">
                            <span class="input-group-text">{{ t('legal.version') }}</span>
                            <input class="form-control" name="version" maxlength="32" required
                                   id="version_{{ entry.type.value }}">
                            <button class="btn btn-outline-primary" type="submit"
                                    data-testid="legal-publish-submit-{{ entry.type.value }}">{{ t('legal.publish') }}</button>
                        </div>
                        <div class="form-text">{{ t('legal.publish_help') }}</div>
                    </form>

                    {% if entry.versions is not empty %}
                        <ul class="list-group list-group-flush mt-2" data-testid="legal-versions-{{ entry.type.value }}">
                            {% for document in entry.versions %}
                                <li class="list-group-item d-flex justify-content-between align-items-center gap-2 small"
                                    data-legal-version="{{ document.version }}" data-legal-locale="{{ document.locale }}">
                                    <span>{{ document.version }} — {{ locale_name(document.locale) }}</span>
                                    <span class="text-body-secondary">
                                        {{ document.publishedDate|localdatetime('short') }}
                                        <code class="ms-2">{{ document.sha256|slice(0, 12) }}</code>
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>

    {# --- Sujets de conformité ------------------------------------------ #}
    {% for item in items %}
        {% set topic = item.topic %}
        <div class="card mb-3" data-compliance-topic="{{ topic.value }}"
             data-compliance-status="{{ item.status.value }}"
             data-compliance-overdue="{{ item.isOverdue(today) ? 'true' : 'false' }}">
            <div class="card-header d-flex justify-content-between align-items-center gap-2">
                <span>{{ t(topic.labelKey) }}</span>
                <span>
                    {% if item.isOverdue(today) %}
                        <span class="badge text-bg-danger">{{ t('compliance.overdue') }}</span>
                    {% endif %}
                    <span class="badge {{ item.status.badgeClass }}"
                          data-testid="status-{{ topic.value }}">{{ t(item.status.labelKey) }}</span>
                </span>
            </div>
            <div class="card-body">
                <dl class="row small mb-3">
                    <dt class="col-sm-3">{{ t('compliance.field.definition') }}</dt>
                    <dd class="col-sm-9">{{ t(topic.definitionKey) }}</dd>
                    <dt class="col-sm-3">{{ t('compliance.field.applicability') }}</dt>
                    <dd class="col-sm-9">{{ t(topic.applicabilityKey) }}</dd>
                    <dt class="col-sm-3">{{ t('compliance.field.where') }}</dt>
                    <dd class="col-sm-9">{{ t(topic.whereKey) }}</dd>
                    <dt class="col-sm-3">{{ t('compliance.field.impact') }}</dt>
                    <dd class="col-sm-9">{{ t(topic.impactKey) }}</dd>
                </dl>

                {% if topic.managedRoute %}
                    <p class="small">
                        <a href="{{ path(topic.managedRoute) }}"
                           data-testid="managed-{{ topic.value }}">{{ t('compliance.managed_elsewhere') }}</a>
                    </p>
                {% endif %}

                <form method="post" action="{{ path('admin.compliance.save', {'topic': topic.value}) }}"
                      data-testid="compliance-form-{{ topic.value }}">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="status_{{ topic.value }}">{{ t('compliance.field.status') }}</label>
                            <select class="form-select" id="status_{{ topic.value }}" name="status">
                                {% for status in ['compliant', 'to_verify', 'not_applicable'] %}
                                    <option value="{{ status }}"
                                            {{ item.status.value == status ? 'selected' : '' }}>{{ t('compliance.status.' ~ status) }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        {% if topic.expectsValue %}
                            <div class="col-12 col-md-8">
                                <label class="form-label" for="value_{{ topic.value }}">{{ t('compliance.field.value') }}</label>
                                <input class="form-control" id="value_{{ topic.value }}" name="value"
                                       maxlength="190" value="{{ item.value }}">
                            </div>
                        {% endif %}
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="last_verified_{{ topic.value }}">{{ t('compliance.field.last_verified') }}</label>
                            <input class="form-control" type="date" id="last_verified_{{ topic.value }}"
                                   name="last_verified" value="{{ item.lastVerified }}">
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="next_review_{{ topic.value }}">{{ t('compliance.field.next_review') }}</label>
                            <input class="form-control" type="date" id="next_review_{{ topic.value }}"
                                   name="next_review" value="{{ item.nextReview }}">
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="source_url_{{ topic.value }}">{{ t('compliance.field.source') }}</label>
                            <input class="form-control" type="url" id="source_url_{{ topic.value }}"
                                   name="source_url" maxlength="500" value="{{ item.sourceUrl }}"
                                   placeholder="https://">
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="notes_{{ topic.value }}">{{ t('compliance.field.notes') }}</label>
                            <textarea class="form-control" rows="2" id="notes_{{ topic.value }}"
                                      name="notes">{{ item.notes }}</textarea>
                        </div>
                    </div>
                    <button class="btn btn-primary mt-3" type="submit"
                            data-testid="compliance-save-{{ topic.value }}">{{ t('common.save') }}</button>
                </form>

                <form method="post" enctype="multipart/form-data" class="mt-3 border-top pt-3"
                      action="{{ path('admin.compliance.evidence', {'topic': topic.value}) }}">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <label class="form-label" for="evidence_{{ topic.value }}">{{ t('compliance.field.evidence') }}</label>
                    <div class="input-group">
                        <input class="form-control" type="file" name="evidence" id="evidence_{{ topic.value }}">
                        <button class="btn btn-outline-secondary" type="submit"
                                data-testid="compliance-evidence-{{ topic.value }}">{{ t('common.send') }}</button>
                    </div>
                    {% if item.evidenceId %}
                        <p class="small mt-2 mb-0">
                            <a href="{{ path('document.download', {'id': item.evidenceId}) }}"
                               data-testid="evidence-{{ topic.value }}">{{ t('compliance.field.evidence_current') }}</a>
                        </p>
                    {% endif %}
                </form>
            </div>
        </div>
    {% endfor %}
{% endblock %}
