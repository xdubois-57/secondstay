{% extends 'layout/admin.html.twig' %}

{% block admin_content %}
    <h1 class="h4 mb-4">{{ t('admin.pricing.title') }}</h1>

    <p class="text-body-secondary">
        {{ t('admin.pricing.intro', {'price': default_night_price|money}) }}
    </p>

    {# --- Calendrier ---------------------------------------------------- #}
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <a class="btn btn-sm btn-outline-secondary"
               href="{{ path('admin.pricing') }}?month={{ calendar.previous }}"
               data-testid="pricing-previous" aria-label="{{ t('booking.calendar.previous') }}">&larr;</a>
            <strong data-testid="pricing-month">{{ calendar_month|monthname }}</strong>
            <a class="btn btn-sm btn-outline-secondary"
               href="{{ path('admin.pricing') }}?month={{ calendar.next }}"
               data-testid="pricing-next" aria-label="{{ t('booking.calendar.next') }}">&rarr;</a>
        </div>
        <div class="card-body">
            <table class="table table-bordered align-middle text-center mb-0 ss-calendar">
                <caption class="visually-hidden">{{ t('booking.calendar.caption') }}</caption>
                <thead>
                    <tr>
                        {% for weekday in weekday_names() %}
                            <th scope="col" class="small text-body-secondary">{{ weekday }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for week in calendar.weeks %}
                        <tr>
                            {% for day in week %}
                                <td class="py-2 {{ day.in_month ? '' : 'text-body-tertiary' }}"
                                    data-admin-day="{{ day.day }}"
                                    data-state="{{ day.state }}"
                                    data-override="{{ day.is_override ? '1' : '0' }}">
                                    <span class="d-block">{{ day.day|slice(8, 2) }}</span>
                                    <span class="d-block small {{ day.is_override ? 'fw-bold' : 'text-body-secondary' }}"
                                          data-night-price>{{ day.price_cents|money }}</span>
                                    {% if day.state == 'blocked' %}
                                        <span class="badge text-bg-secondary">{{ t('booking.calendar.state_blocked') }}</span>
                                    {% endif %}
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# --- Tarifs -------------------------------------------------------- #}
    <div class="card mb-4">
        <div class="card-header">{{ t('admin.pricing.rates') }}</div>
        <div class="card-body">
            <p class="text-body-secondary">{{ t('admin.pricing.rates_help') }}</p>
            <form method="post" action="{{ path('admin.pricing.rates') }}" data-testid="rates-form">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="from">{{ t('admin.pricing.first_night') }}</label>
                        <input class="form-control{{ errors.from is defined ? ' is-invalid' : '' }}"
                               type="date" id="from" name="from" required>
                        {% if errors.from is defined %}<div class="invalid-feedback">{{ t(errors.from) }}</div>{% endif %}
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="to">{{ t('admin.pricing.last_night') }}</label>
                        <input class="form-control" type="date" id="to" name="to" required>
                    </div>
                    <div class="col-12 col-md-2">
                        <label class="form-label" for="price">{{ t('admin.pricing.price') }}</label>
                        <input class="form-control{{ errors.price is defined ? ' is-invalid' : '' }}"
                               id="price" name="price" inputmode="decimal">
                        {% if errors.price is defined %}<div class="invalid-feedback">{{ t(errors.price) }}</div>{% endif %}
                    </div>
                    <div class="col-12 col-md-2">
                        <label class="form-label" for="min_nights">{{ t('admin.pricing.min_nights') }}</label>
                        <input class="form-control" id="min_nights" name="min_nights" type="number" min="0" max="90" value="0">
                    </div>
                    <div class="col-12 col-md-2 d-grid">
                        <button class="btn btn-primary" type="submit" name="action" value="apply"
                                data-testid="apply-rates">{{ t('admin.pricing.apply') }}</button>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="note">{{ t('admin.pricing.note') }}</label>
                        <input class="form-control" id="note" name="note" maxlength="190">
                    </div>
                    <div class="col-12">
                        <button class="btn btn-outline-secondary btn-sm" type="submit" name="action" value="clear"
                                data-testid="clear-rates">{{ t('admin.pricing.clear') }}</button>
                        <span class="small text-body-secondary ms-2">{{ t('admin.pricing.clear_help') }}</span>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {# --- Indisponibilités ---------------------------------------------- #}
    <div class="card">
        <div class="card-header">{{ t('admin.pricing.blocks') }}</div>
        <div class="card-body">
            <form method="post" action="{{ path('admin.pricing.block_create') }}" class="mb-4" data-testid="block-form">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="start">{{ t('admin.pricing.first_night') }}</label>
                        <input class="form-control{{ errors.start is defined ? ' is-invalid' : '' }}"
                               type="date" id="start" name="start" required>
                        {% if errors.start is defined %}<div class="invalid-feedback">{{ t(errors.start) }}</div>{% endif %}
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="end">{{ t('admin.pricing.last_night') }}</label>
                        <input class="form-control" type="date" id="end" name="end" required>
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="kind">{{ t('admin.pricing.kind') }}</label>
                        <select class="form-select" id="kind" name="kind">
                            {% for kind in kinds %}
                                <option value="{{ kind }}">{{ t('admin.pricing.kind_' ~ kind) }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-12 col-md-3 d-grid">
                        <button class="btn btn-primary" type="submit"
                                data-testid="create-block">{{ t('admin.pricing.block_add') }}</button>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="label">{{ t('admin.pricing.label') }}</label>
                        <input class="form-control" id="label" name="label" maxlength="190">
                    </div>
                </div>
            </form>

            <ul class="list-group" data-testid="block-list">
                {% for block in blocks %}
                    <li class="list-group-item d-flex justify-content-between align-items-center"
                        data-block-id="{{ block.id }}">
                        <span>
                            {{ block.start_day }} → {{ block.end_day }}
                            <span class="badge text-bg-secondary ms-2">{{ t('admin.pricing.kind_' ~ block.kind) }}</span>
                            {% if block.label %}<span class="small text-body-secondary d-block">{{ block.label }}</span>{% endif %}
                        </span>
                        <form method="post" action="{{ path('admin.pricing.block_delete', {'id': block.id}) }}">
                            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                            <button class="btn btn-sm btn-outline-danger" type="submit">{{ t('common.delete') }}</button>
                        </form>
                    </li>
                {% else %}
                    <li class="list-group-item text-body-secondary" data-testid="no-block">{{ t('admin.pricing.no_block') }}</li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endblock %}
