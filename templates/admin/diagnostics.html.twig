{% extends 'layout/admin.html.twig' %}

{% block admin_content %}
    <p data-testid="diagnostics-summary">
        <span class="badge text-bg-success">{{ summary.ok }} {{ t('diagnostics.status.ok') }}</span>
        <span class="badge text-bg-warning">{{ summary.warning }} {{ t('diagnostics.status.warning') }}</span>
        <span class="badge text-bg-danger">{{ summary.error }} {{ t('diagnostics.status.error') }}</span>
    </p>

    <div class="card mb-4">
        <div class="card-header">{{ t('diagnostics.category.notification') }}</div>
        <div class="card-body d-flex flex-wrap gap-3 align-items-center">
            <p class="mb-0 text-body-secondary flex-grow-1">{{ t('admin.diagnostics.notification_help') }}</p>
            <a class="btn btn-outline-secondary" href="{{ path('admin.diagnostics') }}?probe=smtp"
               data-testid="probe-smtp">{{ t('admin.diagnostics.probe_smtp') }}</a>
            <form method="post" action="{{ path('admin.diagnostics.push_keys') }}"
                  onsubmit="return confirm('{{ t('admin.diagnostics.push_keys_confirm')|e('js') }}');">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <button class="btn btn-outline-secondary" type="submit" data-testid="generate-push-keys">
                    {{ push_keys_present ? t('admin.diagnostics.push_keys_renew') : t('admin.diagnostics.push_keys_generate') }}
                </button>
            </form>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">{{ t('admin.diagnostics.rate_limits') }}</div>
        <div class="card-body d-flex flex-wrap gap-3 align-items-center">
            <p class="mb-0 text-body-secondary flex-grow-1">{{ t('admin.diagnostics.rate_limits_help') }}</p>
            <form method="post" action="{{ path('admin.diagnostics.rate_limits_clear') }}">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <button class="btn btn-outline-secondary" type="submit" data-testid="clear-rate-limits">
                    {{ t('admin.diagnostics.rate_limits_clear') }}
                </button>
            </form>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">{{ t('admin.diagnostics.migrations') }}</div>
        <div class="card-body">
            <p class="mb-1">{{ t('admin.diagnostics.current_schema') }} : <code data-testid="schema-version">{{ migrations.current ?: '—' }}</code></p>
            {% if migrations.pending %}
                <p class="text-warning-emphasis mb-1">{{ t('admin.diagnostics.pending') }} : {{ migrations.pending|join(', ') }}</p>
            {% else %}
                <p class="text-success-emphasis mb-1">{{ t('diagnostics.schema.up_to_date') }}</p>
            {% endif %}
            {% for warning in migrations.drift %}
                <p class="text-danger-emphasis mb-0 small">{{ warning }}</p>
            {% endfor %}
        </div>
    </div>

    {% for category, results in groups %}
        <div class="card mb-3">
            <div class="card-header">{{ t('diagnostics.category.' ~ category) }}</div>
            <ul class="list-group list-group-flush">
                {% for result in results %}
                    <li class="list-group-item d-flex justify-content-between align-items-center"
                        data-diagnostic="{{ result.id }}" data-status="{{ result.status }}">
                        <span>
                            {{ t('diagnostics.check.' ~ result.id) }}
                            {% if result.details.detail is defined and result.details.detail %}
                                <span class="text-body-secondary small">{{ result.details.detail }}</span>
                            {% endif %}
                        </span>
                        <span class="badge {{ result.badge }}">{{ result.message }}</span>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endfor %}
{% endblock %}
