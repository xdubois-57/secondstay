{% extends 'layout/admin.html.twig' %}

{% block admin_content %}
    <form method="get" class="row g-2 align-items-end mb-4" data-testid="log-filters">
        <div class="col-6 col-md-3">
            <label class="form-label" for="level">{{ t('admin.logs.level') }}</label>
            <select class="form-select" id="level" name="level">
                <option value="">{{ t('admin.logs.all') }}</option>
                {% for value in levels %}
                    <option value="{{ value }}"{{ value == filters.level ? ' selected' : '' }}>{{ t('logging.level.' ~ value) }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label" for="category">{{ t('admin.logs.category') }}</label>
            <select class="form-select" id="category" name="category">
                <option value="">{{ t('admin.logs.all') }}</option>
                {% for value in categories %}
                    <option value="{{ value }}"{{ value == filters.category ? ' selected' : '' }}>{{ value }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label" for="q">{{ t('admin.logs.search') }}</label>
            <input class="form-control" id="q" name="q" value="{{ filters.q }}" type="search">
        </div>
        <div class="col-12 col-md-2">
            <button class="btn btn-outline-primary w-100" type="submit">{{ t('admin.logs.filter') }}</button>
        </div>
    </form>

    <div class="table-responsive mb-3">
        <table class="table table-sm align-middle" data-testid="logs-table">
            <thead>
                <tr>
                    <th scope="col">{{ t('admin.logs.date') }}</th>
                    <th scope="col">{{ t('admin.logs.level') }}</th>
                    <th scope="col">{{ t('admin.logs.category') }}</th>
                    <th scope="col">{{ t('admin.logs.message') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for entry in entries %}
                    <tr data-log-level="{{ entry.level }}">
                        <td class="small text-nowrap">{{ entry.created_at }}</td>
                        <td><span class="badge text-bg-secondary">{{ t('logging.level.' ~ entry.level) }}</span></td>
                        <td class="small">{{ entry.category }}</td>
                        <td class="small">{{ entry.message }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="text-body-secondary">{{ t('admin.logs.empty') }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <p class="mb-0 text-body-secondary small">{{ t('admin.logs.total', {'count': total}) }} — {{ t('admin.logs.page', {'page': page, 'pages': pages}) }}</p>
        <form method="post" action="{{ path('admin.logs.purge') }}">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
            <button class="btn btn-sm btn-outline-danger" type="submit">{{ t('admin.logs.purge', {'days': retention_days}) }}</button>
        </form>
    </div>
{% endblock %}
