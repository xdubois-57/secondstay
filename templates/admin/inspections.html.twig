{% extends 'layout/admin.html.twig' %}

{% block admin_content %}
    <p class="text-body-secondary">{{ t('inspection.admin.intro') }}</p>

    <ul class="nav nav-tabs mb-4" data-testid="zone-locales">
        {% for available in locales %}
            <li class="nav-item">
                <a class="nav-link{{ available == current_locale ? ' active' : '' }}"
                   href="{{ path('admin.inspections') }}?locale={{ available }}"
                   data-zone-locale="{{ available }}">{{ locale_name(available) }}</a>
            </li>
        {% endfor %}
    </ul>

    <div class="card mb-4">
        <div class="card-header">{{ t('inspection.admin.completeness') }}</div>
        <div class="card-body small text-body-secondary py-2">{{ t('inspection.admin.completeness_help') }}</div>
        <ul class="list-group list-group-flush" data-testid="zone-completeness">
            {% for code, filled in completeness %}
                <li class="list-group-item d-flex justify-content-between align-items-center" data-zone="{{ code }}">
                    <span>{{ t('inspection.zone.' ~ code) }}</span>
                    <span>
                        {% for available in locales %}
                            <span class="badge {{ available in filled ? 'text-bg-success' : 'text-bg-secondary' }}"
                                  data-locale="{{ available }}"
                                  data-filled="{{ available in filled ? 'true' : 'false' }}">{{ available|upper }}</span>
                        {% endfor %}
                    </span>
                </li>
            {% else %}
                <li class="list-group-item" data-testid="zone-empty">{{ t('inspection.admin.no_zone') }}</li>
            {% endfor %}
        </ul>
        {% if zones is empty %}
            <div class="card-footer">
                <form method="post" action="{{ path('admin.inspections.seed') }}">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <button class="btn btn-outline-primary" type="submit"
                            data-testid="zone-seed">{{ t('inspection.admin.seed') }}</button>
                </form>
            </div>
        {% endif %}
    </div>

    {% for row in zones %}
        <div class="card mb-3" data-zone-editor="{{ row.zone.code }}">
            <div class="card-header d-flex justify-content-between align-items-center gap-2">
                <span>{{ row.zone.label ?: t(row.zone.labelKey) }}</span>
                <span>
                    <span class="badge {{ row.zone.active ? 'text-bg-success' : 'text-bg-secondary' }}"
                          data-zone-active="{{ row.zone.active ? 'true' : 'false' }}">{{ t('inspection.admin.active') }}</span>
                    <span class="badge {{ row.zone.photoRequired ? 'text-bg-warning' : 'text-bg-secondary' }}"
                          data-zone-photo="{{ row.zone.photoRequired ? 'true' : 'false' }}">{{ t('inspection.photo_required') }}</span>
                </span>
            </div>
            <div class="card-body">
                <form method="post" action="{{ path('admin.inspections.zone') }}"
                      data-testid="zone-form-{{ row.zone.code }}">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <input type="hidden" name="locale" value="{{ current_locale }}">
                    <input type="hidden" name="code" value="{{ row.zone.code }}">

                    <div class="row g-3">
                        <div class="col-12 col-md-8">
                            <label class="form-label" for="name_{{ row.zone.code }}">{{ t('inspection.admin.name') }}</label>
                            <input class="form-control" id="name_{{ row.zone.code }}" name="name"
                                   maxlength="190" value="{{ row.zone.name }}">
                        </div>
                        <div class="col-6 col-md-4">
                            <label class="form-label" for="position_{{ row.zone.code }}">{{ t('inspection.admin.position') }}</label>
                            <input class="form-control" type="number" min="0" max="9999"
                                   id="position_{{ row.zone.code }}" name="position" value="{{ row.zone.position }}">
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="instructions_{{ row.zone.code }}">{{ t('inspection.admin.instructions') }}</label>
                            <textarea class="form-control" rows="2" id="instructions_{{ row.zone.code }}"
                                      name="instructions">{{ row.zone.instructions }}</textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="reference_note_{{ row.zone.code }}">{{ t('inspection.admin.reference_note') }}</label>
                            <input class="form-control" id="reference_note_{{ row.zone.code }}"
                                   name="reference_note" maxlength="255" value="{{ row.zone.referenceNote }}">
                        </div>
                        <div class="col-12 d-flex gap-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" value="1"
                                       id="active_{{ row.zone.code }}" name="active"
                                       {{ row.zone.active ? 'checked' : '' }}>
                                <label class="form-check-label" for="active_{{ row.zone.code }}">{{ t('inspection.admin.active') }}</label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" value="1"
                                       id="photo_required_{{ row.zone.code }}" name="photo_required"
                                       {{ row.zone.photoRequired ? 'checked' : '' }}>
                                <label class="form-check-label" for="photo_required_{{ row.zone.code }}">{{ t('inspection.photo_required') }}</label>
                            </div>
                        </div>
                    </div>

                    <button class="btn btn-primary mt-3" type="submit"
                            data-testid="zone-save-{{ row.zone.code }}">{{ t('common.save') }}</button>
                </form>

                <hr>

                <p class="mb-2">{{ t('inspection.admin.reference_photos') }}</p>
                {% if row.references is empty %}
                    <p class="text-body-secondary small" data-testid="no-reference-{{ row.zone.code }}">{{ t('inspection.admin.no_reference') }}</p>
                {% else %}
                    <ul class="list-inline" data-testid="references-{{ row.zone.code }}">
                        {% for documentId in row.references %}
                            <li class="list-inline-item">
                                <a href="{{ path('document.download', {'id': documentId}) }}"
                                   data-reference="{{ documentId }}">{{ t('inspection.photo_n', {'index': loop.index}) }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                <form method="post" enctype="multipart/form-data"
                      action="{{ path('admin.inspections.reference', {'id': row.zone.id}) }}"
                      class="d-flex gap-2 align-items-end flex-wrap">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <input type="hidden" name="locale" value="{{ current_locale }}">
                    <div class="flex-grow-1">
                        <label class="form-label" for="reference_{{ row.zone.code }}">{{ t('inspection.admin.add_reference') }}</label>
                        <input class="form-control" type="file" accept="image/*" name="photo"
                               id="reference_{{ row.zone.code }}">
                    </div>
                    <button class="btn btn-outline-secondary" type="submit"
                            data-testid="reference-upload-{{ row.zone.code }}">{{ t('common.send') }}</button>
                </form>
            </div>
        </div>
    {% endfor %}

    <div class="card">
        <div class="card-header">{{ t('inspection.admin.new_zone') }}</div>
        <div class="card-body">
            <form method="post" action="{{ path('admin.inspections.zone') }}" data-testid="zone-create">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <input type="hidden" name="locale" value="{{ current_locale }}">
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="new_code">{{ t('inspection.admin.code') }}</label>
                        <input class="form-control" id="new_code" name="code" maxlength="32" required>
                        <div class="form-text">{{ t('inspection.admin.code_help') }}</div>
                    </div>
                    <div class="col-12 col-md-5">
                        <label class="form-label" for="new_name">{{ t('inspection.admin.name') }}</label>
                        <input class="form-control" id="new_name" name="name" maxlength="190">
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="new_position">{{ t('inspection.admin.position') }}</label>
                        <input class="form-control" type="number" min="0" max="9999" id="new_position"
                               name="position" value="100">
                    </div>
                </div>
                <div class="d-flex gap-4 mt-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" value="1"
                               id="new_active" name="active" checked>
                        <label class="form-check-label" for="new_active">{{ t('inspection.admin.active') }}</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" value="1"
                               id="new_photo_required" name="photo_required">
                        <label class="form-check-label" for="new_photo_required">{{ t('inspection.photo_required') }}</label>
                    </div>
                </div>
                <button class="btn btn-primary mt-3" type="submit"
                        data-testid="zone-create-submit">{{ t('common.create') }}</button>
            </form>
        </div>
    </div>
{% endblock %}
