{# États des lieux et incidents d'un séjour. #}
<div class="card mb-4" data-testid="admin-inspections">
    <div class="card-header d-flex justify-content-between align-items-center gap-2">
        <span>{{ t('inspection.title') }}</span>
        <a class="small" href="{{ path('admin.bookings.inspections', {'id': booking.id}) }}"
           data-testid="inspection-detail-link">{{ t('inspection.admin.detail') }}</a>
    </div>
    <ul class="list-group list-group-flush">
        {% for inspection in inspections %}
            {% set progress = inspection.progress %}
            <li class="list-group-item d-flex justify-content-between align-items-center gap-2"
                data-inspection-kind="{{ inspection.kind.value }}"
                data-inspection-status="{{ inspection.status.value }}">
                <span>{{ t(inspection.kind.labelKey) }}</span>
                <span>
                    <span class="small text-body-secondary">{{ progress.done }} / {{ progress.total }}</span>
                    <span class="badge {{ inspection.status.badgeClass }}">{{ t(inspection.status.labelKey) }}</span>
                </span>
            </li>
        {% else %}
            <li class="list-group-item text-body-secondary"
                data-testid="inspection-none">{{ t('inspection.not_started') }}</li>
        {% endfor %}
    </ul>
    <div class="card-header border-top">{{ t('incident.title') }}</div>
    <ul class="list-group list-group-flush" data-testid="booking-incidents">
        {% for incident in incidents %}
            <li class="list-group-item d-flex justify-content-between align-items-center gap-2"
                data-incident-id="{{ incident.id }}">
                <a href="{{ path('admin.incidents.show', {'id': incident.id}) }}">{{ incident.title }}</a>
                <span class="badge {{ incident.status.badgeClass }}">{{ t(incident.status.labelKey) }}</span>
            </li>
        {% else %}
            <li class="list-group-item text-body-secondary"
                data-testid="booking-incidents-empty">{{ t('incident.empty') }}</li>
        {% endfor %}
    </ul>
</div>
