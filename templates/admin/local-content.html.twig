{% extends 'layout/admin.html.twig' %}

{% block admin_content %}
    <p class="text-body-secondary">{{ t('local.admin.intro') }}</p>

    <p class="alert {{ enabled ? 'alert-success' : 'alert-secondary' }}" data-testid="local-enabled"
       data-enabled="{{ enabled ? 'true' : 'false' }}" data-provider="{{ provider }}">
        {{ enabled ? t('local.enabled') : (configured ? t('local.disabled') : t('local.not_configured')) }}
        <a class="ms-2" href="{{ path('admin.settings') }}?module=llm">{{ t('local.configure') }}</a>
    </p>

    {# --- Sources ------------------------------------------------------- #}
    <div class="card mb-4">
        <div class="card-header">{{ t('local.sources') }}</div>
        <ul class="list-group list-group-flush" data-testid="local-sources">
            {% for source in sources %}
                <li class="list-group-item d-flex justify-content-between align-items-center gap-2"
                    data-source-id="{{ source.id }}" data-source-active="{{ source.active ? 'true' : 'false' }}">
                    <span class="text-break">
                        <span class="d-block">{{ source.label ?: source.url }}</span>
                        <code class="small">{{ source.url }}</code>
                        <span class="d-block small text-body-secondary" data-source-status="{{ source.lastStatus }}">
                            {{ t(source.statusLabelKey) }}
                        </span>
                    </span>
                    <span class="d-inline-flex gap-2">
                        <form method="post" action="{{ path('admin.local.source_toggle', {'id': source.id}) }}">
                            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                            <button class="btn btn-sm btn-outline-secondary" type="submit"
                                    data-testid="source-toggle-{{ source.id }}">
                                {{ source.active ? t('local.deactivate') : t('local.activate') }}
                            </button>
                        </form>
                        <form method="post" action="{{ path('admin.local.source_delete', {'id': source.id}) }}">
                            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                            <button class="btn btn-sm btn-outline-danger" type="submit"
                                    data-testid="source-delete-{{ source.id }}">{{ t('common.delete') }}</button>
                        </form>
                    </span>
                </li>
            {% else %}
                <li class="list-group-item text-body-secondary"
                    data-testid="local-sources-empty">{{ t('local.no_source') }}</li>
            {% endfor %}
        </ul>
        <div class="card-body">
            <form method="post" action="{{ path('admin.local.source_add') }}" data-testid="local-source-form">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-7">
                        <label class="form-label" for="url">{{ t('local.field.url') }}</label>
                        <input class="form-control" type="url" id="url" name="url" required placeholder="https://">
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="label">{{ t('local.field.label') }}</label>
                        <input class="form-control" id="label" name="label" maxlength="190">
                    </div>
                    <div class="col-12 col-md-2 d-grid">
                        <button class="btn btn-primary" type="submit"
                                data-testid="local-source-add">{{ t('local.add_source') }}</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {# --- Consigne ------------------------------------------------------ #}
    <div class="card mb-4">
        <div class="card-header">{{ t('local.prompt') }}</div>
        <div class="card-body">
            <p class="small text-body-secondary">{{ t('local.prompt_intro') }}</p>

            <form method="post" action="{{ path('admin.local.prompt') }}" data-testid="local-prompt-form">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <label class="form-label" for="prompt">{{ t('local.field.prompt') }}</label>
                <textarea class="form-control" id="prompt" name="prompt" rows="5"
                          maxlength="4000">{{ suggested ?: instructions }}</textarea>
                <button class="btn btn-primary mt-3" type="submit"
                        data-testid="local-prompt-save">{{ t('common.save') }}</button>
            </form>

            <form method="post" action="{{ path('admin.local.suggest') }}" class="mt-3 border-top pt-3">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <button class="btn btn-outline-secondary" type="submit"
                        data-testid="local-prompt-suggest"
                        {{ has_location ? '' : 'disabled' }}>{{ t('local.suggest_prompt') }}</button>
                <span class="small text-body-secondary ms-2" data-testid="local-location">
                    {{ has_location ? location : t('local.error.no_location') }}
                </span>
            </form>
        </div>
    </div>

    {# --- Essai et rafraîchissement -------------------------------------- #}
    <div class="card mb-4">
        <div class="card-header">{{ t('local.run') }}</div>
        <div class="card-body">
            <p class="small text-body-secondary">
                {{ t('local.window', {'weeks': window_weeks, 'days': refresh_days}) }}
                <span class="d-block" data-testid="local-due" data-due="{{ due }}">
                    {{ t('local.due', {'count': due}) }}
                </span>
            </p>

            <div class="d-flex gap-2 flex-wrap">
                <form method="post" action="{{ path('admin.local.test') }}" class="d-flex gap-2">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <select class="form-select" name="locale" aria-label="{{ t('common.language') }}">
                        {% for available in locales %}
                            <option value="{{ available }}">{{ locale_name(available) }}</option>
                        {% endfor %}
                    </select>
                    <button class="btn btn-outline-primary" type="submit"
                            data-testid="local-test">{{ t('local.test') }}</button>
                </form>

                <form method="post" action="{{ path('admin.local.refresh') }}">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <button class="btn btn-outline-primary" type="submit"
                            data-testid="local-refresh">{{ t('local.refresh') }}</button>
                </form>
            </div>
        </div>
    </div>

    {# --- Exécutions ----------------------------------------------------- #}
    <div class="card">
        <div class="card-header">{{ t('local.runs') }}</div>
        <ul class="list-group list-group-flush" data-testid="local-generations">
            {% for run in generations %}
                <li class="list-group-item d-flex justify-content-between align-items-center gap-2"
                    data-generation-status="{{ run.status }}" data-generation-items="{{ run.items }}">
                    <span>
                        <span class="badge {{ run.status == 'done' ? 'text-bg-success' : 'text-bg-danger' }}">
                            {{ t('local.status.' ~ run.status) }}
                        </span>
                        <span class="ms-2">{{ run.range_start }} → {{ run.range_end }}</span>
                        <span class="d-block small text-body-secondary">{{ run.locale|upper }} — {{ run.created_at }}</span>
                    </span>
                    <span class="small text-body-secondary text-end">
                        {{ t('local.run_summary', {'sources': run.sources, 'items': run.items}) }}
                        {% if run.error %}
                            <span class="d-block text-danger" data-generation-error="{{ run.error }}">{{ t(run.error) }}</span>
                        {% endif %}
                    </span>
                </li>
            {% else %}
                <li class="list-group-item text-body-secondary"
                    data-testid="local-generations-empty">{{ t('local.no_run') }}</li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
